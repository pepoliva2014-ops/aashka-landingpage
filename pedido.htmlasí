<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aashka · Confirmación de pedido</title>
<style>
  :root {
    --cream: #FBF6EE;
    --cream-2: #F3EBDB;
    --ink: #2E2A22;
    --olive: #6B7F4F;
    --olive-dark: #4F5F3A;
    --clay: #C77B4B;
    --line: #E3D8C2;
    --white: #FFFFFF;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    min-height: 100vh;
    padding: 24px 16px 64px;
  }
  .wrap { max-width: 480px; margin: 0 auto; }
  header { text-align: center; margin-bottom: 20px; }
  header img { width: 84px; height: auto; margin-bottom: 8px; }
  header h1 { font-size: 20px; margin: 4px 0 2px; letter-spacing: 0.3px; }
  header p { margin: 0; font-size: 13px; opacity: 0.6; }

  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 16px;
  }
  label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--olive-dark);
  }
  input[type="text"] {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 15px;
    background: var(--cream-2);
    color: var(--ink);
    margin-bottom: 14px;
  }
  input[type="text"]:focus {
    outline: 2px solid var(--olive);
    outline-offset: 1px;
  }

  .paquete-row {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1.5px solid var(--line);
    border-radius: 12px 12px 0 0;
    padding: 12px 14px;
    background: var(--cream-2);
  }
  .paquete-row.activo { border-color: var(--olive); background: #EEF1E4; }
  .paquete-row .info { flex-grow: 1; }
  .paquete-row .info .nom { font-weight: 600; font-size: 14px; }
  .paquete-row .info .det { font-size: 12px; color: #6b6559; }
  .paquete-row .precio { font-weight: 700; color: var(--olive-dark); font-size: 14px; white-space: nowrap; margin-right: 4px; }

  .aroma-row {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1.5px solid var(--line);
    border-top: none;
    border-radius: 0 0 12px 12px;
    padding: 10px 14px;
    background: var(--white);
    margin-bottom: 10px;
  }
  .aroma-label { font-size: 12px; font-weight: 600; color: #6b6559; white-space: nowrap; }
  .aroma-select {
    flex-grow: 1;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 13px;
    background: var(--cream-2);
    color: var(--ink);
  }

  .stepper {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .stepper button {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--white);
    font-size: 17px;
    font-weight: 700;
    color: var(--olive-dark);
    cursor: pointer;
    line-height: 1;
  }
  .stepper button:active { background: var(--cream-2); }
  .stepper .cant {
    width: 28px;
    text-align: center;
    font-weight: 700;
    font-size: 15px;
  }

  .divider-note {
    font-size: 12px;
    color: #8a8370;
    margin: 4px 0 12px;
  }

  .resumen {
    background: var(--olive-dark);
    color: var(--white);
    border-radius: 16px;
    padding: 18px 20px;
    margin-bottom: 16px;
  }
  .resumen .fila { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; font-size: 14px; }
  .resumen .fila:last-child { margin-bottom: 0; }
  .resumen .total-num { font-size: 26px; font-weight: 700; }
  .resumen .fila.total { padding-top: 10px; margin-top: 6px; border-top: 1px solid rgba(255,255,255,0.25); }

  .mensaje-box {
    background: var(--cream-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px;
    font-size: 14px;
    line-height: 1.55;
    white-space: pre-wrap;
    margin-bottom: 14px;
    color: var(--ink);
  }

  button.copiar {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 12px;
    background: var(--olive);
    color: white;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }
  button.copiar:active { background: var(--olive-dark); }
  .copiado-msg {
    text-align: center;
    font-size: 13px;
    color: var(--olive-dark);
    margin-top: 8px;
    height: 16px;
    font-weight: 600;
  }

  footer {
    text-align: center;
    margin-top: 20px;
    font-size: 12px;
    color: #8a8370;
  }
  footer strong { color: var(--olive-dark); }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <img src="data:image/png;base64," alt="Aashka logo">
    <h1>Aashka · Confirmación de pedido</h1>
    <p>Uso interno — para pedidos tomados por teléfono</p>
  </header>

  <div class="card">
    <label for="nombre">Nombre del cliente</label>
    <input type="text" id="nombre" placeholder="Ej. María González">

    <label>Paquetes de 8 piezas</label>
    <div class="divider-note">Puedes combinar varios paquetes, cada uno con su propio aroma.</div>

    <div class="paquete-row" data-key="grande8">
      <div class="info">
        <div class="nom">Grande</div>
        <div class="det">92 g · Mariposa · 8 piezas</div>
      </div>
      <div class="precio">$260</div>
      <div class="stepper">
        <button type="button" class="menos" data-target="qGrande8">−</button>
        <span class="cant" id="qGrande8">0</span>
        <button type="button" class="mas" data-target="qGrande8">+</button>
      </div>
    </div>
    <div class="aroma-row" id="aromaRow_qGrande8">
      <span class="aroma-label">Aroma:</span>
      <select id="aroma_qGrande8" class="aroma-select">
        <option value="Bergamota">Bergamota</option>
        <option value="Manzana canela">Manzana canela</option>
        <option value="Frutos rojos">Frutos rojos</option>
        <option value="Lavanda">Lavanda</option>
        <option value="Pino">Pino</option>
        <option value="Sándalo">Sándalo</option>
      </select>
    </div>
    <div class="paquete-row" data-key="mediano8">
      <div class="info">
        <div class="nom">Mediano</div>
        <div class="det">70 g · Liso · 8 piezas</div>
      </div>
      <div class="precio">$200</div>
      <div class="stepper">
        <button type="button" class="menos" data-target="qMediano8">−</button>
        <span class="cant" id="qMediano8">0</span>
        <button type="button" class="mas" data-target="qMediano8">+</button>
      </div>
    </div>
    <div class="aroma-row" id="aromaRow_qMediano8">
      <span class="aroma-label">Aroma:</span>
      <select id="aroma_qMediano8" class="aroma-select">
        <option value="Bergamota">Bergamota</option>
        <option value="Manzana canela">Manzana canela</option>
        <option value="Frutos rojos">Frutos rojos</option>
        <option value="Lavanda">Lavanda</option>
        <option value="Pino">Pino</option>
        <option value="Sándalo">Sándalo</option>
      </select>
    </div>
    <div class="paquete-row" data-key="chico8">
      <div class="info">
        <div class="nom">Chico</div>
        <div class="det">60 g · 8 piezas</div>
      </div>
      <div class="precio">$170</div>
      <div class="stepper">
        <button type="button" class="menos" data-target="qChico8">−</button>
        <span class="cant" id="qChico8">0</span>
        <button type="button" class="mas" data-target="qChico8">+</button>
      </div>
    </div>
    <div class="aroma-row" id="aromaRow_qChico8">
      <span class="aroma-label">Aroma:</span>
      <select id="aroma_qChico8" class="aroma-select">
        <option value="Bergamota">Bergamota</option>
        <option value="Manzana canela">Manzana canela</option>
        <option value="Frutos rojos">Frutos rojos</option>
        <option value="Lavanda">Lavanda</option>
        <option value="Pino">Pino</option>
        <option value="Sándalo">Sándalo</option>
      </select>
    </div>

  </div>

  <div class="card">
    <label>Piezas sueltas (mezcla de tamaños)</label>
    <div class="divider-note">Para pedidos que no llegan a un paquete de 8.</div>

    <div class="paquete-row" data-key="grandeU">
      <div class="info">
        <div class="nom">Grande individual</div>
        <div class="det"></div>
      </div>
      <div class="precio">$65 c/u</div>
      <div class="stepper">
        <button type="button" class="menos" data-target="qGrandeU">−</button>
        <span class="cant" id="qGrandeU">0</span>
        <button type="button" class="mas" data-target="qGrandeU">+</button>
      </div>
    </div>
    <div class="aroma-row" id="aromaRow_qGrandeU">
      <span class="aroma-label">Aroma:</span>
      <select id="aroma_qGrandeU" class="aroma-select">
        <option value="Bergamota">Bergamota</option>
        <option value="Manzana canela">Manzana canela</option>
        <option value="Frutos rojos">Frutos rojos</option>
        <option value="Lavanda">Lavanda</option>
        <option value="Pino">Pino</option>
        <option value="Sándalo">Sándalo</option>
      </select>
    </div>
    <div class="paquete-row" data-key="medianoU">
      <div class="info">
        <div class="nom">Mediano individual</div>
        <div class="det"></div>
      </div>
      <div class="precio">$50 c/u</div>
      <div class="stepper">
        <button type="button" class="menos" data-target="qMedianoU">−</button>
        <span class="cant" id="qMedianoU">0</span>
        <button type="button" class="mas" data-target="qMedianoU">+</button>
      </div>
    </div>
    <div class="aroma-row" id="aromaRow_qMedianoU">
      <span class="aroma-label">Aroma:</span>
      <select id="aroma_qMedianoU" class="aroma-select">
        <option value="Bergamota">Bergamota</option>
        <option value="Manzana canela">Manzana canela</option>
        <option value="Frutos rojos">Frutos rojos</option>
        <option value="Lavanda">Lavanda</option>
        <option value="Pino">Pino</option>
        <option value="Sándalo">Sándalo</option>
      </select>
    </div>
    <div class="paquete-row" data-key="chicoU">
      <div class="info">
        <div class="nom">Chico individual</div>
        <div class="det"></div>
      </div>
      <div class="precio">$45 c/u</div>
      <div class="stepper">
        <button type="button" class="menos" data-target="qChicoU">−</button>
        <span class="cant" id="qChicoU">0</span>
        <button type="button" class="mas" data-target="qChicoU">+</button>
      </div>
    </div>
    <div class="aroma-row" id="aromaRow_qChicoU">
      <span class="aroma-label">Aroma:</span>
      <select id="aroma_qChicoU" class="aroma-select">
        <option value="Bergamota">Bergamota</option>
        <option value="Manzana canela">Manzana canela</option>
        <option value="Frutos rojos">Frutos rojos</option>
        <option value="Lavanda">Lavanda</option>
        <option value="Pino">Pino</option>
        <option value="Sándalo">Sándalo</option>
      </select>
    </div>

  </div>

  <div class="resumen">
    <div class="fila"><span>Piezas de jabón vendidas</span><span id="totalPiezas">0</span></div>
    <div class="fila total"><span>Costo final</span><span class="total-num">$<span id="totalCosto">0</span> MXN</span></div>
  </div>

  <div class="mensaje-box" id="mensajeConfirmacion">Completa los datos arriba para generar la confirmación del pedido.</div>

  <button class="copiar" id="btnCopiar">Copiar confirmación de pedido</button>
  <div class="copiado-msg" id="copiadoMsg"></div>

  <footer>
    <strong>Aashka · Crea tu esencia</strong><br>
    Jabones artesanales hechos a mano en México<br>
    55 3826 0372 · @crea_tu_esencia
  </footer>
</div>

<script>
const ITEMS = {
  qGrande8:  { nombre: "Paquete Grande (8 piezas)",  piezas: 8, precio: 260, fila: 'grande8' },
  qMediano8: { nombre: "Paquete Mediano (8 piezas)", piezas: 8, precio: 200, fila: 'mediano8' },
  qChico8:   { nombre: "Paquete Chico (8 piezas)",   piezas: 8, precio: 170, fila: 'chico8' },
  qGrandeU:  { nombre: "Grande individual",  piezas: 1, precio: 65, fila: 'grandeU' },
  qMedianoU: { nombre: "Mediano individual", piezas: 1, precio: 50, fila: 'medianoU' },
  qChicoU:   { nombre: "Chico individual",   piezas: 1, precio: 45, fila: 'chicoU' },
};

const nombreInput = document.getElementById('nombre');
const totalPiezasEl = document.getElementById('totalPiezas');
const totalCostoEl = document.getElementById('totalCosto');
const mensajeEl = document.getElementById('mensajeConfirmacion');
const btnCopiar = document.getElementById('btnCopiar');
const copiadoMsg = document.getElementById('copiadoMsg');

function getCantidad(id) {
  return parseInt(document.getElementById(id).textContent) || 0;
}
function setCantidad(id, val) {
  const v = Math.max(0, val);
  document.getElementById(id).textContent = v;
  const row = document.querySelector('[data-key="' + ITEMS[id].fila + '"]');
  if (row) row.classList.toggle('activo', v > 0);
}

document.querySelectorAll('.stepper button').forEach(btn => {
  btn.addEventListener('click', () => {
    const id = btn.dataset.target;
    const actual = getCantidad(id);
    const delta = btn.classList.contains('mas') ? 1 : -1;
    setCantidad(id, actual + delta);
    calcular();
  });
});

document.querySelectorAll('.aroma-select').forEach(sel => {
  sel.addEventListener('change', calcular);
});

function calcular() {
  let piezas = 0;
  let costo = 0;
  const partes = [];

  Object.keys(ITEMS).forEach(id => {
    const cant = getCantidad(id);
    if (cant > 0) {
      const item = ITEMS[id];
      piezas += cant * item.piezas;
      costo += cant * item.precio;
      const aroma = document.getElementById('aroma_' + id).value;
      const etiqueta = (cant > 1 ? cant + ' × ' + item.nombre : item.nombre) + ' — ' + aroma;
      partes.push(etiqueta);
    }
  });

  totalPiezasEl.textContent = piezas;
  totalCostoEl.textContent = costo;

  const nombre = nombreInput.value.trim();

  if (partes.length === 0) {
    mensajeEl.textContent = 'Completa los datos arriba para generar la confirmación del pedido.';
    return;
  }

  const nombreTxt = nombre ? nombre : '[nombre del cliente]';
  const listaPedido = partes.map(p => '• ' + p).join('\n');

  mensajeEl.textContent =
    '¡Hola ' + nombreTxt + '! 🌿 Aquí tu confirmación de pedido Aashka:\n\n' +
    '📦 Pedido:\n' + listaPedido + '\n\n' +
    '🧼 Piezas de jabón: ' + piezas + '\n' +
    '💰 Total: $' + costo + ' MXN\n\n' +
    'Gracias por tu pedido, en breve coordinamos el envío.\n\n' +
    'Aashka · Crea tu esencia\n' +
    '📱 55 3826 0372';
}

nombreInput.addEventListener('input', calcular);

calcular();
</script>
</body>
</html>
